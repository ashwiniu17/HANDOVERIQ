# Copy this file to ".env" (in the backend folder) and fill in real values.
# ".env" is ignored by Git: never commit real keys or passwords.

# --- Environment ---------------------------------------------------------------
# "development" locally. "production" turns on strict safety checks at startup:
# the server REFUSES to start in production with a weak SECRET_KEY, a SQLite
# database, or insecure cookies.
ENVIRONMENT=development

# --- Database ------------------------------------------------------------------
# Local development: a SQLite file inside backend/ (no setup needed).
DATABASE_URL=sqlite:///./handoveriq.db
# Production: PostgreSQL. A "postgres://" or "postgresql://" address from Neon,
# Supabase or Render works as it is. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Create or update the database tables automatically when the server starts.
AUTO_MIGRATE=true

# --- Sessions and security -------------------------------------------------------
# Signs the login session. REQUIRED in production: a random value of 32+ characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-development-only
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Cookie settings. Locally the defaults are right. In production with the website
# and the API on DIFFERENT sites (for example netlify.app and onrender.com):
#   COOKIE_SAMESITE=none  and  COOKIE_SECURE=true
# If both live under one domain (app.example.com and api.example.com), use lax.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# --- Web app (CORS) ----------------------------------------------------------------
# Comma-separated addresses the website is served from (no trailing slash needed).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Show the interactive API documentation at /api/docs (true/false).
ENABLE_DOCS=true
LOG_LEVEL=INFO

# --- Uploads ---------------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_PROJECT=30

# --- Failed sign-in throttling -----------------------------------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# --- Anthropic (AI analysis) ----------------------------------------------------------------
# Create a key at https://console.anthropic.com/ . Without it the app works, but
# documents cannot be analyzed and the AI screens say so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=150000
AI_MAX_OUTPUT_TOKENS=8000
