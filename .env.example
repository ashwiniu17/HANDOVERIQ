# ============================================================================
# HANDOVERIQ: reference list of every setting.
# Nothing reads THIS file. Copy the relevant lines into:
#   backend/.env         (the backend, see backend/.env.example for comments)
#   frontend/.env.local  (the website, see frontend/.env.example)
# or into your hosting provider's environment settings.
# ============================================================================

# ---------------- Backend ----------------
ENVIRONMENT=development
DATABASE_URL=sqlite:///./handoveriq.db
AUTO_MIGRATE=true
SECRET_KEY=change-me-in-development-only
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_DOCS=true
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_PROJECT=30
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=150000
AI_MAX_OUTPUT_TOKENS=8000

# ---------------- Frontend ----------------
# Public address of the backend, no trailing slash. Use "localhost" (not
# 127.0.0.1) for both sides locally so the session cookie is kept.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
