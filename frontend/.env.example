# Copy this file to ".env.local" and edit it. ".env.local" is ignored by Git.

# Public address of the HANDOVERIQ backend, WITHOUT a trailing slash.
#
# Local development. Use "localhost" (not 127.0.0.1) for BOTH the website and the
# backend, so the browser treats them as the same site and keeps the session cookie:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Production (set it in Netlify -> Site configuration -> Environment variables):
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.onrender.com
